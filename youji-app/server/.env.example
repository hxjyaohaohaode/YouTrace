# Local synthetic development only. Never deploy this sample signing secret.
NODE_ENV=development
PORT=3000
DATABASE_URL=file:./dev.db
JWT_SECRET=local-development-only-replace-before-deploy
ALLOWED_ORIGINS=http://localhost:5180,http://localhost:4173
TRUST_PROXY=false
DEV_OTP_EXPOSE=true

SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=

# Optional account-owned AI storage: independent 32-byte base64 encryption key.
# Never commit a real key. Missing key disables saving/using AI credentials.
# Preserve the matching key separately alongside every database backup.
AI_CREDENTIAL_ENCRYPTION_KEY=

# Optional deployment-owned basic chat, OFF until all fields are explicit.
# Users must still select and consent to this source in Coach. BYOK is separate.
# Exact supported official bases and domestic model families: docs/SERVER_AI_20261010.md.
# Set provider spending caps yourself before enabling. Never use VITE_* for secrets.
SERVER_AI_ENABLED=false
SERVER_AI_API_KEY=
SERVER_AI_BASE_URL=
SERVER_AI_MODEL=
