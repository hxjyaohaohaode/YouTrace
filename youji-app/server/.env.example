# Local synthetic development only. Never deploy this sample signing secret.
NODE_ENV=development
PORT=3000
DATABASE_URL=file:./dev.db
JWT_SECRET=local-development-only-replace-before-deploy
ALLOWED_ORIGINS=http://localhost:5180,http://localhost:4173
TRUST_PROXY=false
DEV_OTP_EXPOSE=true

# Leave providers empty for deterministic local rule replies and dev OTP.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
