# Local synthetic development only. Never deploy this sample signing secret.
NODE_ENV=development
PORT=3000
DATABASE_URL=file:./dev.db
JWT_SECRET=local-development-only-replace-before-deploy
ALLOWED_ORIGINS=http://localhost:5180,http://localhost:4173
TRUST_PROXY=false
DEV_OTP_EXPOSE=true

SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=

# Optional account-owned AI storage: independent 32-byte base64 encryption key.
# Never commit a real key. Missing key disables saving/using AI credentials.
# Preserve the matching key separately alongside every database backup.
AI_CREDENTIAL_ENCRYPTION_KEY=
