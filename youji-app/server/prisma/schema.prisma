generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id
  phone        String   @unique
  nickname     String
  avatar       String   @default("")
  identity     String   @default("student")
  city         String   @default("")
  coachStyle   String   @default("gentle")
  quietStart   String   @default("23:00")
  quietEnd     String   @default("07:00")
  pushLimit    Int      @default(3)
  ignoredCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  aiConnection UserAIConnection?
  goals        Goal[]
  schedules    Schedule[]
  expenses     Expense[]
  todos        Todo[]
  habits       Habit[]
  quickNotes   QuickNote[]
  diaries      Diary[]
  chatSessions ChatSession[]
  insights     Insight[]
  pushes       Push[]
  syncChanges  SyncChange[]
  syncTombstones SyncTombstone[]
  syncReceipts SyncReceipt[]
  accountPreferences AccountPreferences?
  preferenceReceipts AccountPreferenceReceipt[]
}

// Account policy, separate from browser theme and local delivery counters.
model AccountPreferences {
  userId String @id
  revision Int @default(0)
  coachStyle String @default("gentle")
  coachPushEnabled Boolean @default(false)
  pushLimit Int @default(2)
  quietEnabled Boolean @default(true)
  quietStart String @default("23:00")
  quietEnd String @default("07:00")
  eveningReviewEnabled Boolean @default(false)
  eveningReviewTime String @default("21:00")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccountPreferenceReceipt {
  userId String
  mutationId String
  requestHash String
  response String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, mutationId])
}

// Goal writes use the versioned sync API, including manual progress.
model Goal {
  id          String   @id
  userId      String
  title       String
  description String   @default("")
  level       String   @default("short")
  domain      String
  priority    String   @default("medium")
  progress    Int      @default(0)
  targetDate  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])

  @@index([userId, level])
}

model Schedule {
  id        String   @id
  userId    String
  title     String
  date      String
  startTime String
  endTime   String
  type      String   @default("other")
  location  String   @default("")
  repeat    String   @default("none")
  remind    Int      @default(0)
  exceptions String  @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

model Expense {
  id          String   @id
  userId      String
  amount      Int
  category    String
  name        String
  date        String
  source      String   @default("manual")
  relatedMood String?
  isIncome    Boolean  @default(false)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

model Todo {
  id        String   @id
  userId    String
  text      String
  dueDate   String?
  priority  String   @default("medium")
  done      Boolean  @default(false)
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, done])
}

model Habit {
  id        String   @id
  userId    String
  name      String
  icon      String
  frequency String   @default("daily")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  habitCheckins HabitCheckin[]

  @@index([userId])
}

model HabitCheckin {
  id        String   @id
  habitId   String
  date      String
  done      Boolean  @default(true)
  source    String   @default("manual")
  aiReason  String?
  confirmed Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habit Habit @relation(fields: [habitId], references: [id])

  @@unique([habitId, date])
}

model QuickNote {
  id        String   @id
  userId    String
  content   String
  timestamp BigInt
  parsed    String
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
}

model Diary {
  id        String   @id
  userId    String
  date      String
  content   String
  mood      String?
  moodScore Int?
  source    String   @default("manual")
  aiInsight String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model ChatSession {
  id          String   @id
  userId      String
  triggerType String   @default("user_initiated")
  createdAt   DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id])
  messages ChatMessage[]

  @@index([userId, createdAt])
}

model ChatMessage {
  id        String   @id
  sessionId String
  role      String
  content   String
  actions   String?
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
  source String @default("legacy")
}

model Insight {
  id              String   @id
  userId          String
  type            String
  title           String
  description     String
  dataSources     String
  actionSuggested String?
  actionTaken     Boolean  @default(false)
  actionResult    String?
  dismissed       Boolean  @default(false)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Push {
  id        String   @id
  userId    String
  insightId String?
  type      String
  title     String
  body      String
  actions   String?
  read      Boolean  @default(false)
  acted     Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read, createdAt])
}

model AuthChallenge {
  id          String    @id
  phone       String
  purpose     String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

model RegistrationTicket {
  id         String    @id
  phone      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, expiresAt])
  @@index([expiresAt])
}

// SQLite triggers write this append-only feed in the business transaction.
// SQL uses INTEGER AUTOINCREMENT; read seq via CAST AS TEXT (see syncProtocol).
model SyncChange {
  seq       BigInt @id @default(autoincrement())
  userId    String
  entity    String
  entityId  String
  operation String
  payload   String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, seq])
  @@index([userId, entity, entityId, seq])
}

model SyncTombstone {
  userId   String
  entity   String
  entityId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, entity, entityId])
}

model SyncReceipt {
  userId     String
  mutationId String
  requestHash String
  response   String
  createdAt  DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, mutationId])
}

model RevokedSession {
  id String @id
  expiresAt DateTime

  @@index([expiresAt])
}

// One optional user-owned connection; credentials never enter sync or export.
model UserAIConnection {
  id String @unique
  userId String @id
  providerId String
  model String
  cipher String
  version Int @default(1)
  chatConsent Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
