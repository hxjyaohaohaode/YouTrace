# Copy to .env; set private values locally. No credentials are generated here.
JWT_SECRET=
ALLOWED_ORIGINS=https://localhost:8443
# Required for real production login. No development codes are exposed.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
# Optional account-owned AI credential storage. Leave blank to keep model use unavailable.
# Supply only your separately approved existing 32-byte Base64 encryption key.
# Preserve this exact key separately with its matching encrypted database backups.
# Do not generate a replacement during restore or put provider API keys here.
AI_CREDENTIAL_ENCRYPTION_KEY=
